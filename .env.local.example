# Copy to .env.local to customize local development. All values are optional.
# MongoDB must be on this machine and use the metamarket_local database.
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/metamarket_local
LOCAL_SESSION_SECRET=

# Use a separate Google OAuth client with the callback below.
# http://localhost:8080/mapi/auth/google/callback
LOCAL_GOOGLE_CLIENT_ID=
LOCAL_GOOGLE_CLIENT_SECRET=

# Use a separate Cloudinary account if testing uploads.
LOCAL_CLOUDINARY_CLOUD_NAME=
LOCAL_CLOUDINARY_API_KEY=
LOCAL_CLOUDINARY_API_SECRET=
