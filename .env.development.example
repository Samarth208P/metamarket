# Copy to .env for local development
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/mapi/auth/google/callback
FRONTEND_URL=http://localhost:8080

# Local Supabase CLI database. Start with pnpm db:start.
SUPABASE_DEV_DATABASE_URL=postgresql://metamarket_backend:metamarket_local_dev@127.0.0.1:54322/postgres
SUPABASE_DEV_URL=http://127.0.0.1:54321
# pnpm db:start sets the local service key in .env.
SUPABASE_DEV_STORAGE_KEY=

# Private Codex submission token and signed-in admin allowed to approve proposals.
METAMARKET_CODEX_TOKEN=
METAMARKET_REVIEW_OWNER_EMAIL=
