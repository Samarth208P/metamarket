# Set these values as Supabase Edge Function secrets.
NODE_ENV=production

FRONTEND_URL=https://metamarket.live
GOOGLE_CALLBACK_URL=https://metamarket.live/mapi/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Supavisor transaction-mode URI for metamarket_backend ending in ?sslmode=verify-full.
METAMARKET_DATABASE_URL=
# Server-side Supabase secret API key for admin image uploads.
METAMARKET_STORAGE_KEY=
# Match the metamarket_cron_token secret in Supabase Vault.
METAMARKET_CRON_TOKEN=
